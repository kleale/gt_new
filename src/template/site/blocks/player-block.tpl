			.reztable .playHero {
				text-align: left;
				position: relative;
				display: flex;
				align-items: center;
			}
			.reztable .playHero .hero {
				width: 33px;
				margin-right: 5px;
			}
			.reztable .playHero .hero {
				margin-right: 5px;
				max-width: 50px;
				max-height: none;
			}
			.playHero .hero {
				width: 1.8rem;
				max-width: 50px;
				margin-right: 5px;
				position: relative;
				display: block;
				border-radius: 2px;
			}
			.playHero .hero > * {
				border-radius: 2px;
			}
			.playHero .hero img {
				width: 100%;
			}
			.hero img {
				min-height: 1rem;
			}
			.reztable .playHero .name {
				display: flex;
				flex-direction: column;
				flex-grow: 1;
				width: 60%;
			}
			.reztable .playHero .name a {
				font-size: 11px;
			}
			.reztable .playHero .name span {
				color: #9e9e9e;
				font-size: 0.9rem;
			}
			.reztable .playHero .name s {
				text-decoration: none;
				font-style: normal;
				padding: 0 0.15rem;
				font-size: 0.9rem;
				color: #babdce;
				border: 1px solid #babdce;
				margin-right: 0.3rem;
				border-radius: 0.5rem;
			}

			.reztable .table td.bb {
				font-weight: 700;
			}

			.reztable .table td {
				vertical-align: middle;
				border-top: 0;
			}

			.reztable .items {
				display: block;
				text-align: left;
				min-width: 165px;
				/*max-width: 100px;*/
			}
			.item {
				display: block;
				max-width: 21px;
				overflow: hidden;
				font-size: 10px;
				float: left;
				margin-right: 2px;
			}

			.item > * {
				max-width: 100%;
				max-height: 100%;
				border-radius: 2px;
			}

			.green {
				color: #82ac4e !important;
			}

			.reztable .table .tname .fa-trophy {
				color: #f2c94c;
				margin: 0 0.3rem;
			}
			@media(min-width: 930px) {
				.modal-content {
					width: max-content;
					right: 25%;
				}
			}
			.fb-danger {
				color: #fff;
				background-color: #dc3545;
				border-radius: 2px;
				padding: 3px 7px;
				font-weight: 700;
				font-size: 10px;
			}
			.dire {
				color: #ea6465 !important;
			}
			.orange {
				color: #fc7c00 !important;
			}
		</style>
