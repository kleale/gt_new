<script>
	function match_result2(text) {
var txt = '';
var title = 'Результаты игры <i class="fa fa-fw fa-clock-o"></i> 30 мин 55 сек';
if (title != '') 
txt += '<div class="modal-header"><button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button><h4 class="modal-title">' + (
title != '' ? title : SERVER_HOSTNAME
) + '</h4></div>';



var text = $('#data').html();

txt += '<div class="modal-body">' + text + '</div>';
$('#wms .modal-content').html(txt);
$('#wms').modal();
}
</script>
